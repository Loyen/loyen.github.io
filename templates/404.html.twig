{% extends 'page.html.twig' %}

{% set title = 'Not found' %}

{% block content %}
<div class="message">
    <h1>Page not found</h1>
    <p>Perhaps you want to visit the <a href="/">home page</a> instead?</p>
</div>
{% endblock %}

{% block style %}
.siteMain {
    align-self: center;
}

.message {
    text-align: center;
    padding: var(--spacing-medium);
    font-size: clamp(1em, 2dvw, 1.5em);
}
{% endblock %}
