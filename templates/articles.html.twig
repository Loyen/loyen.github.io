{% extends 'page.html.twig' %}

{% set title = 'Articles' %}

{% block content %}
<div class="articles">
    {% for article in articles %}
        <div class="article">
            <div class="article-meta">
                <p class="article-created">{{ article.created.format('Y-m-d') }}</p>
                <a href="{{ article.url }}">
                    <h2 class="article-title">{{ article.title }}</h2>
                </a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}

{% block style %}

.articles {
    align-self: center;
    max-width: var(--site-width);
    padding-inline: var(--spacing-small);
    width: 100%;
}

.article-meta {
    align-items: center;
    display: inline-grid;
    gap: var(--spacing-medium);
    grid-template-columns: auto auto;
}


{% endblock %}
