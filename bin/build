#!/usr/bin/env php
<?php

require_once 'vendor/autoload.php';

use App\Article;
use App\Messenger;
use App\PageGenerator;
use League\CommonMark\Environment\Environment as CommonMarkEnvironment;
use League\CommonMark\Extension\CommonMark\CommonMarkCoreExtension;
use League\CommonMark\Extension\Footnote\FootnoteExtension;
use League\CommonMark\Extension\FrontMatter\FrontMatterExtension;
use League\CommonMark\Extension\FrontMatter\Output\RenderedContentWithFrontMatter;
use League\CommonMark\MarkdownConverter;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\Filesystem\Path;
use Symfony\Component\Finder\Finder;
use Twig\Environment;
use Twig\Loader\FilesystemLoader;

define('ROOT', dirname(__DIR__));

$assetsDirectory = ROOT.'/assets';
$templateDirectory = ROOT.'/templates';
$twigCacheDirectory = ROOT.'/.twig.cache';
$targetDirectory = Path::makeRelative(ROOT.'/_site', ROOT);

$messenger = new Messenger();
$filesystem = new Filesystem();
$pageGenerator = new PageGenerator(
    $filesystem,
    new Environment(new FilesystemLoader($templateDirectory)),
    $messenger,
);

$messenger->write('Creating assets');
$filesystem->mirror($assetsDirectory, $targetDirectory.'/assets');

$messenger->write('Creating article pages');

$config = [
    'html_input' => 'allow',
    'allow_unsafe_links' => false,
    'footnote' => [
        'backref_class' => 'footnote-backref',
        'backref_symbol' => '↩',
        'container_add_hr' => true,
        'container_class' => 'footnotes',
        'ref_class' => 'footnote-ref',
        'ref_id_prefix' => 'fnref:',
        'footnote_class' => 'footnote',
        'footnote_id_prefix' => 'fn:',
    ],
];

$markdownEnvironment = new CommonMarkEnvironment($config);
$markdownEnvironment->addExtension(new CommonMarkCoreExtension());
$markdownEnvironment->addExtension(new FootnoteExtension());
$markdownEnvironment->addExtension(new FrontMatterExtension());

$markdownConverter = new MarkdownConverter($markdownEnvironment);

$sourceDirectory = Path::makeRelative(ROOT.'/docs', ROOT);

$finder = new Finder();
$finder->files()->in($sourceDirectory);

$articles = [];

foreach ($finder as $file) {
    $absoluteFilePath = $file->getRealPath();

    $messenger->write("Reading <info>{$sourceDirectory}/{$file->getFilename()}</>");

    /** @var RenderedContentInterface&FrontMatterProviderInterface */
    $markdown = $markdownConverter->convert((string) file_get_contents($absoluteFilePath));

    $frontmatter = $markdown->getFrontMatter() ?? [];

    $uri = "/articles/{$frontmatter['alias']}";

    $article = new Article(
        $frontmatter['title'] ?? '',
        DateTimeImmutable::createFromFormat('Y-m-d', $frontmatter['created'] ?? ''),
        $markdown->getContent(),
        $uri,
        $frontmatter['tags'] ?? [],
    );

    $articles[] = $article;

    $pageGenerator->create(
        "{$targetDirectory}{$uri}/index.html",
        'article.html.twig',
        ['article' => $article],
    );
}

$pageGenerator->create(
    Path::makeRelative($targetDirectory.'/articles/index.html', ROOT),
    'articles.html.twig',
    ['articles' => $articles],
);

$messenger->write('Creating base pages');

$pages = [
    'home.html.twig' => $targetDirectory.'/index.html',
    '404.html.twig' => $targetDirectory.'/404.html',
];

foreach ($pages as $templateFilePath => $targetFilePath) {
    $pageGenerator->create(
        Path::makeRelative($targetFilePath, ROOT),
        $templateFilePath,
        []
    );
}
