        "symfony/filesystem": "^8.0",
        "league/commonmark": "^2.8",
        "symfony/finder": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1"
    }
}
